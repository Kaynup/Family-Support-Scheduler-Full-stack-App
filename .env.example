# ==============================================================================
# Family Support Scheduler — Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# Database Configuration (MySQL 8.0 / TiDB Cloud Serverless)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=family_supp_sche
DB_TABLE=bills
DB_CONN_POOLING=5
DB_SSL=true

# Authentication & Security
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://family-scheduler-web.vercel.app
